# Public app URL used when sharing group invitations (HTTPS domain in production)
VITE_PUBLIC_URL=https://example.com/
# The installed mobile app needs a reachable HTTPS backend (relative /api works on the web)
VITE_API_URL=https://example.com/api
# Browser-visible Supabase project URL and publishable/anon key (never use service_role in VITE_ vars)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server-side values (same project as above); do not commit real values
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Optional allowed additional web origins, comma-separated; native app origins are built-in
APP_ORIGINS=https://example.com
